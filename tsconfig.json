{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",                  
    "baseUrl": ".",                   
    "paths": {
      "config/*": ["src/config/*"],
      "controllers/*": ["src/controllers/*"],
      "models/*": ["src/models/*"],
      "routes/*": ["src/routes/*"],
      "services/*": ["src/services/*"],
      "views/*": ["src/views/*"],
      "prisma/*": ["prisma/scripts/*"]  
    }
  },
  "include": ["src", "prisma/scripts"]
}
