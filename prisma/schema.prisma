generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model license_plates {
  id                 Int              @id @default(autoincrement())
  license_plate      String           @db.VarChar(20)
  capture_time       DateTime?        @default(now()) @db.DateTime(0)
  image_license_data String?          @db.LongText
  image_path         String?
  vehicle_images     vehicle_images[]

  @@index([image_license_data(length: 768)], map: "image_license_data")
}

model vehicle_details {
  id                  Int     @id @default(autoincrement())
  phone_number        String? @db.VarChar(15)
  citizen_id          String? @db.VarChar(20)
  address             String? @db.VarChar(255)
  license_plate       String? @db.VarChar(20)
  personal_image_data String? @db.LongText
}

model vehicle_images {
  id               Int             @id @default(autoincrement())
  capture_time     DateTime?       @db.DateTime(0)
  speed            Float?          @db.Float
  image_path       String?
  license_plate_id Int?
  image_data       String?         @db.LongText
  license_plate    license_plates? @relation(fields: [license_plate_id], references: [id])

  @@index([license_plate_id], map: "vehicle_images_license_plate_id_fkey")
}
