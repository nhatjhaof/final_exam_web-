<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Vehicle Detection System</title>
  <link rel="stylesheet" href="/assets/style.css">
</head>

<body>
  <div class="header">Vehicle Detection System</div>

  <div class="container">
    <table class="vehicle-table">
      <thead>
        <tr>
          <th>Id</th>
          <th>Vehicle Image</th>
          <th>Timestamp</th>
          <th>Speed (km/h)</th>
          <th>License Plate</th>
        </tr>
      </thead>
      <tbody>
        <% cars.forEach(function (car) { %>
          <tr data-owner="<%= car.owner_info %>">
            <td><%= car.id %></td>
            <td>
                <% if (car.image_path) { %>
                    <img src="/images/vehicle/<%= car.image_path %>" width="150" />
                <% } else { %>
                    <span>No image</span>
                <% } %>
            </td>
            <td><%= new Date(car.capture_time).toLocaleString() %></td>
            <td><%= car.speed %></td>
            <td>
              <% if (car.license_plate && car.license_plate.image_path) { %>
                <img src="/images/license_plates/<%= car.license_plate.image_path %>" alt="Plate" class="plate-img" width="80" height="40" />
              <% } else { %>
                <span>No image</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <!-- Vùng hiển thị thông tin chủ xe -->
    <div id="owner-info"></div>
  </div>

  <!-- Script xử lý hiển thị thông tin chủ xe -->
  <script>
    const rows = document.querySelectorAll('.vehicle-table tbody tr');
    const infoDiv = document.getElementById('owner-info');

    rows.forEach(row => {
      row.addEventListener('mouseover', () => {
        const owner = row.dataset.owner;
        infoDiv.textContent = 'Thông tin chủ xe: ' + (owner || 'Không có');
      });
      row.addEventListener('mouseleave', () => {
        infoDiv.textContent = '';
      });
    });
  </script>
</body>
</html>
